{
  "name": "MH",
  "version": 2,
  "meta": {
    "source": "Structure: Leap-pm-web/src/styles.css + src/components (LEAP). Palette and shape: the MH monogram (brand/logo, lime #c2f852 sampled from the original lockup)."
  },
  "color": {
    "themes": [
      { "id": "dark", "name": "Dark" },
      { "id": "light", "name": "Light" }
    ],
    "tokens": [
      { "name": "lime-100", "value": "#f0fdd4", "usage": "Palette. Faint lime wash on light grounds." },
      { "name": "lime-300", "value": "#dcfb98", "usage": "Palette. Tint for highlights on dark." },
      { "name": "lime-500", "value": "#c2f852", "usage": "Palette. THE brand lime, from the mark. Fills only; never text on light grounds (1.2:1 on white)." },
      { "name": "lime-600", "value": "#a9de36", "usage": "Palette. Hover for lime fills." },
      { "name": "lime-700", "value": "#86b41c", "usage": "Palette. Pressed lime fills." },
      { "name": "lime-900", "value": "#3d5806", "usage": "Palette. Text-safe lime on light grounds." },
      { "name": "carbon-950", "value": "#0b0d0a", "usage": "Palette. The deepest ground; the logo's backdrop." },
      { "name": "carbon-900", "value": "#14170f", "usage": "Palette. Raised dark surface." },
      { "name": "carbon-800", "value": "#1d2117", "usage": "Palette. Wells and fields on dark." },
      { "name": "carbon-700", "value": "#2b3023", "usage": "Palette. Hairlines on dark." },
      { "name": "carbon-500", "value": "#6c7660", "usage": "Palette. Control borders on dark." },
      { "name": "bone-50", "value": "#fafaf7", "usage": "Palette. Off-white ground." },
      { "name": "bone-100", "value": "#f1f2ec", "usage": "Palette. Wells on light." },
      { "name": "bone-200", "value": "#e3e5dc", "usage": "Palette. Hairlines on light." },
      { "name": "bone-400", "value": "#83887a", "usage": "Palette. Control borders on light." },

      { "name": "surface", "value": { "dark": "{carbon-950}", "light": "{bone-50}" }, "usage": "Page background." },
      { "name": "surface-raised", "value": { "dark": "{carbon-900}", "light": "#ffffff" }, "usage": "Cards, menus, dialogs." },
      { "name": "surface-field", "value": { "dark": "{carbon-800}", "light": "{bone-100}" }, "usage": "Inputs, wells, table headers." },
      { "name": "surface-inverse", "value": { "dark": "{bone-50}", "light": "{carbon-950}" }, "usage": "Tooltips and toasts: the opposite of the page." },
