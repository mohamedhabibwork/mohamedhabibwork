      { "name": "critical-soft", "value": { "dark": "#33141a", "light": "#fce8eb" }, "usage": "Error alert / badge ground." },
      { "name": "on-critical", "value": { "dark": "{carbon-950}", "light": "#ffffff" }, "usage": "Text on critical fills." },
      { "name": "info", "value": { "dark": "#7bcdf2", "light": "#2366a8" }, "usage": "Informational text and icons." },
      { "name": "info-soft", "value": { "dark": "#0f2531", "light": "#e5f1fb" }, "usage": "Info alert / badge ground." },
      { "name": "chart-1", "value": { "dark": "{lime-500}", "light": "#5d8a0c" }, "usage": "Chart series 1 (brand). Assign in order; always ship a legend." },
      { "name": "chart-2", "value": { "dark": "#7bcdf2", "light": "#2a78d6" }, "usage": "Chart series 2." },
      { "name": "chart-3", "value": { "dark": "#f2994b", "light": "#d4600f" }, "usage": "Chart series 3." },
      { "name": "chart-4", "value": { "dark": "#c39cff", "light": "#7a5fc9" }, "usage": "Chart series 4." },
