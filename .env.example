# Postgres connection used by the app, drizzle-kit and the seed script
DATABASE_URL=postgres://postgres:@localhost:5432/habib_portfolio

# Dashboard owner. Generate the hash with: bun run hash-password '<password of 12+ chars>'
ADMIN_EMAIL="admin@mohamedhabib.work"
ADMIN_PASSWORD_HASH=pbkdf2:100000:<salt>:<hash>

# Bearer token for owner MCP tools (messages, writes). Generate: openssl rand -hex 32
MCP_TOKEN=<64 hex chars from: openssl rand -hex 32>

# Canonical site origin used for SEO (canonical, sitemap, JSON-LD)
VITE_SITE_URL=https://mohamedhabib.work

# Optional search-engine ownership tokens (rendered as <meta> tags). DNS verification needs neither.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Cloudflare Turnstile. Sitekey is public (build-time); the secret is a wrangler secret in production.
# Local dev can use Cloudflare's always-pass test keys with TURNSTILE_ALLOW_TEST_KEYS=1.
VITE_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=mohamedhabib.work
TURNSTILE_ALLOW_TEST_KEYS=
