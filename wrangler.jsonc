{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mohamed-habib-portfolio",
	"account_id": "dfd0934ada854fb30ecb91fe050f5294",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server-entry.ts",
	"observability": { "enabled": true },
	// mohamedhabib.me is canonical; the others 301 to it (see src/server.ts).
	"routes": [
		{ "pattern": "mohamedhabib.me", "custom_domain": true },
		{ "pattern": "www.mohamedhabib.me", "custom_domain": true },
		{ "pattern": "mohamedhabib.work", "custom_domain": true },
		{ "pattern": "habib.cloud", "custom_domain": true }
	],
	"vars": {
		"SITE_URL": "https://mohamedhabib.me",
		"ADMIN_EMAIL": "admin@mohamedhabib.work",
		"MAIL_FROM": "no-reply@mohamedhabib.me",
		"CONTACT_TO": "mohamedhabibwork@gmail.com"
	},
	// Cloudflare Email Service. Onboard the domain once:
	//   bunx wrangler email sending enable mohamedhabib.me (already enabled)
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["no-reply@mohamedhabib.me"],
			"allowed_destination_addresses": ["mohamedhabibwork@gmail.com"]
		}
	],
	// Postgres via Hyperdrive. Create once and paste the id:
	//   bunx wrangler hyperdrive create habib-portfolio-db --connection-string="$DATABASE_URL"
	// `localConnectionString` is used by `vite dev` (Hyperdrive requires a password in the URL;
	// a local trust-auth Postgres ignores it). Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "REPLACE_WITH_HYPERDRIVE_ID",
			"localConnectionString": "postgres://postgres:local@127.0.0.1:5432/habib_portfolio"
		}
	]
	// Secrets (never commit): bunx wrangler secret put ADMIN_PASSWORD_HASH / MCP_TOKEN
}
