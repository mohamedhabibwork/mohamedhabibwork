{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mohamed-habib-portfolio",
	"account_id": "dfd0934ada854fb30ecb91fe050f5294",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/server-entry.ts",
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": true,
	// mohamedhabib.work is canonical; the others 301 to it (see src/server-entry.ts).
	"routes": [
		{
			"pattern": "mohamedhabib.me",
			"custom_domain": true
		},
		{
			"pattern": "mohamedhabib.work",
			"custom_domain": true
		},
		{
			"pattern": "www.mohamedhabib.work",
			"custom_domain": true
		},
		{
			"pattern": "habib.cloud",
			"custom_domain": true
		}
	],
	"vars": {
		"SITE_URL": "https://mohamedhabib.work",
		"ADMIN_EMAIL": "admin@mohamedhabib.work",
		"MAIL_FROM": "no-reply@mohamedhabib.work",
		"CONTACT_TO": "mohamedhabibwork@gmail.com"
	},
	// Cloudflare Email Service. Onboard the domain once:
	//   bunx wrangler email sending enable mohamedhabib.work (already enabled)
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"no-reply@mohamedhabib.work"
			],
			"allowed_destination_addresses": [
				"mohamedhabibwork@gmail.com"
			]
		}
	],
	// Postgres via Hyperdrive. Create once and paste the id:
	//   bunx wrangler hyperdrive create habib-portfolio-db --connection-string="$DATABASE_URL"
	// `localConnectionString` is used by `vite dev` (Hyperdrive requires a password in the URL;
	// a local trust-auth Postgres ignores it). Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "6db10d8d70e94200a26c7d339055d568",
			"localConnectionString": "postgres://postgres:local@127.0.0.1:5432/habib_portfolio"
		}
	]
	// Secrets (never commit): bunx wrangler secret put ADMIN_PASSWORD_HASH / MCP_TOKEN
}